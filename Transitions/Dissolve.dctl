// clang-format off
DEFINE_UI_PARAMS(smooth, Smooth, DCTLUI_CHECK_BOX, 1)
DEFINE_UI_PARAMS(input_tf, Input Transfer Function, DCTLUI_COMBO_BOX, 0, {INPUT_TF_LINEAR, INPUT_TF_ACESCC, INPUT_TF_ACESCCT, INPUT_TF_LOGC3, INPUT_TF_DAVINCI_INTERMEDIATE, INPUT_TF_PQ, INPUT_TF_GAMMA_24}, {Linear, ACEScc, ACEScct, Arri LogC3, DaVinci Intermediate, PQ, Gamma 2.4})
DEFINE_UI_PARAMS(alpha_behavior, Alpha Behavior, DCTLUI_COMBO_BOX, 0, {ALPHA_PREMULTIPLY, ALPHA_PREMULTIPLY_OUTPUT_1, ALPHA_STRAIGHT}, {Premultiply, Premultiply but Output 1, Straight})
// clang-format on

__DEVICE__ float powi(float x, int exp) {
    float out = 1.0f;
    int abs_exp = exp < 0 ? exp * -1 : exp;
    for (int i = 0; i < abs_exp; ++i) {
        out *= x;
    }
    if (exp < 0) {
        out = 1.0f / out;
    }
    return out;
}

__DEVICE__ float powf(float base, float exp) {
    return _copysignf(_powf(_fabs(base), exp), base);
}

__DEVICE__ float mixf(float x, float y, float a) {
    return x * (1.0f - a) + y * a;
}

__DEVICE__ float3 mixf3(float3 x, float3 y, float a) {
    return make_float3(mixf(x.x, y.x, a), mixf(x.y, y.y, a), mixf(x.z, y.z, a));
}

__DEVICE__ float4 mixf4(float4 x, float4 y, float a) {
    return make_float4(mixf(x.x, y.x, a), mixf(x.y, y.y, a), mixf(x.z, y.z, a), mixf(x.w, y.w, a));
}

__DEVICE__ float smoothstep2(float start, float end, float alpha) {
    // alpha expected to be from 0 to 1.
    // https://www.desmos.com/calculator/pernscu1gx
    alpha = _clampf(alpha, 0.0f, 1.0f);
    float factor;
    if (alpha < 0.5f) {
        factor = 0.5f * powi(alpha * 2.0f, 3);
    } else {
        factor = 0.5f * (2.0f - powi(2.0f - (alpha * 2.0f), 3));
    }
    return mixf(start, end, factor);
}

__DEVICE__ float acescc_to_linear(float in) {
    if (in < -0.3013698630f) { // (9.72f-15)/17.52f
        return (_exp2f(in * 17.52f - 9.72f) - _exp2f(-16.0f)) * 2.0f;
    } else {
        return _exp2f(in * 17.52f - 9.72f);
    }
}

__DEVICE__ float linear_to_acescc(float in) {
    if (in <= 0.0f) {
        return -0.3584474886f; // =(log2( pow(2.f,-16.f))+9.72f)/17.52f
    } else if (in < _exp2f(-15.0f)) {
        return (_log2f(_exp2f(-16.0f) + in * 0.5f) + 9.72f) / 17.52f;
    } else {
        return (_log2f(in) + 9.72f) / 17.52f;
    }
}

__DEVICE__ float acescct_to_linear(float in) {
    // const float X_BRK = 0.0078125f;
    const float Y_BRK = 0.155251141552511f;
    const float A = 10.5402377416545f;
    const float B = 0.0729055341958355f;
    if (in > Y_BRK) {
        return _exp2f(in * 17.52f - 9.72f);
    } else {
        return (in - B) / A;
    }
}

__DEVICE__ float linear_to_acescct(float in) {
    const float X_BRK = 0.0078125f;
    // const float Y_BRK = 0.155251141552511f;
    const float A = 10.5402377416545f;
    const float B = 0.0729055341958355f;
    if (in <= X_BRK) {
        return A * in + B;
    } else { // (in > X_BRK)
        return (_log2f(in) + 9.72f) / 17.52f;
    }
}

__DEVICE__ float arri_logc3_to_linear(float x) {
    float cut = 0.010591f;
    float a = 5.555556f;
    float b = 0.052272f;
    float c = 0.247190f;
    float d = 0.385537f;
    float e = 5.367655f;
    float f = 0.092809f;
    if (x > e * cut + f) {
        return (_exp10f((x - d) / c) - b) / a;
    } else {
        return (x - f) / e;
    }
}

__DEVICE__ float linear_to_arri_logc3(float x) {
    float cut = 0.010591f;
    float a = 5.555556f;
    float b = 0.052272f;
    float c = 0.247190f;
    float d = 0.385537f;
    float e = 5.367655f;
    float f = 0.092809f;

    if (x > cut) {
        return c * _log10f(a * x + b) + d;
    } else {
        return e * x + f;
    }
}

__DEVICE__ float davinci_intermediate_to_linear(float t) {
    const float a = 0.0075f;
    const float b = 7.0f;
    const float c = 0.07329248f;
    const float m = 10.44426855f;
    // const float lin_cut = 0.00262409f; // Should be equal to ((cut2 - f) / e)
    const float log_cut = 0.02740668f; // should be equal to (e * cut1 + f)

    if (t > log_cut) {
        return _exp2f((t / c) - b) - a;
    } else {
        return t / m;
    }
}

__DEVICE__ float linear_to_davinci_intermediate(float x) {
    const float a = 0.0075f;
    const float b = 7.0f;
    const float c = 0.07329248f;
    const float m = 10.44426855f;
    const float lin_cut = 0.00262409f; // Should be equal to ((cut2 - f) / e)
    // const float log_cut = 0.02740668f; // should be equal to (e * cut1 + f)

    if (x > lin_cut) {
        return (_log2f(x + a) + b) * c;
    } else {
        return x * m;
    }
}

#define DISPLAY_MID_GRAY (0.10f)

__DEVICE__ float st2084_to_linear(float x) {
    // x is code value 0-1, outputs linear light with 1.0 = 100 nits
    const float m1 = 1305.0f / 8192.0f;
    const float m2 = 2523.0f / 32.0f;
    const float c1 = 3424.0f / 4096.0f;
    const float c2 = 2413.0f / 128.0f;
    const float c3 = 2392.0f / 128.0f;

    float out_lin = 100.0f * powf(_fmaxf(powf(x, 1.0f / m2) - c1, 0.0f) / (c2 - (c3 * powf(x, 1.0f / m2))), 1.0f / m1);

    // Gain 10 nits to mid gray.
    out_lin *= 0.18f / DISPLAY_MID_GRAY;
    return out_lin;
}

__DEVICE__ float linear_to_st2084(float y) {
    // Gain mid gray to 10 nits.
    y = y * DISPLAY_MID_GRAY / 0.18f;
    float x = y / 100.0f;
    x = _fmaxf(x, 0.0f);

    // x is code value 0-1, y is linear light with 1.0 = 100 nits.
    const float m1 = 1305.0f / 8192.0f;
    const float m2 = 2523.0f / 32.0f;
    const float c1 = 3424.0f / 4096.0f;
    const float c2 = 2413.0f / 128.0f;
    const float c3 = 2392.0f / 128.0f;

    return powf((c1 + c2 * powf(x, m1)) / (1.0f + c3 * powf(x, m1)), m2);
}

__DEVICE__ float3 log_to_lin(float3 input_rgb, int input_tf) {
    float3 output = make_float3(0.0f, 0.0f, 0.0f);
    if (input_tf == INPUT_TF_LINEAR) {
        output = input_rgb;
    } else if (input_tf == INPUT_TF_ACESCC) {
        output.x = acescc_to_linear(input_rgb.x);
        output.y = acescc_to_linear(input_rgb.y);
        output.z = acescc_to_linear(input_rgb.z);
    } else if (input_tf == INPUT_TF_ACESCCT) {
        output.x = acescct_to_linear(input_rgb.x);
        output.y = acescct_to_linear(input_rgb.y);
        output.z = acescct_to_linear(input_rgb.z);
    } else if (input_tf == INPUT_TF_LOGC3) {
        output.x = arri_logc3_to_linear(input_rgb.x);
        output.y = arri_logc3_to_linear(input_rgb.y);
        output.z = arri_logc3_to_linear(input_rgb.z);
    } else if (input_tf == INPUT_TF_DAVINCI_INTERMEDIATE) {
        output.x = davinci_intermediate_to_linear(input_rgb.x);
        output.y = davinci_intermediate_to_linear(input_rgb.y);
        output.z = davinci_intermediate_to_linear(input_rgb.z);
    } else if (input_tf == INPUT_TF_PQ) {
        output.x = st2084_to_linear(input_rgb.x);
        output.y = st2084_to_linear(input_rgb.y);
        output.z = st2084_to_linear(input_rgb.z);
    } else if (input_tf == INPUT_TF_GAMMA_24) {
        output.x = powf(input_rgb.x, 2.4f) * 0.18f / DISPLAY_MID_GRAY;
        output.y = powf(input_rgb.y, 2.4f) * 0.18f / DISPLAY_MID_GRAY;
        output.z = powf(input_rgb.z, 2.4f) * 0.18f / DISPLAY_MID_GRAY;
    }
    return output;
}

__DEVICE__ float3 lin_to_log(float3 input_rgb, int output_tf) {
    float3 output = make_float3(0.0f, 0.0f, 0.0f);
    if (output_tf == INPUT_TF_LINEAR) {
        output = input_rgb;
    } else if (output_tf == INPUT_TF_ACESCC) {
        output.x = linear_to_acescc(input_rgb.x);
        output.y = linear_to_acescc(input_rgb.y);
        output.z = linear_to_acescc(input_rgb.z);
    } else if (output_tf == INPUT_TF_ACESCCT) {
        output.x = linear_to_acescct(input_rgb.x);
        output.y = linear_to_acescct(input_rgb.y);
        output.z = linear_to_acescct(input_rgb.z);
    } else if (output_tf == INPUT_TF_LOGC3) {
        output.x = linear_to_arri_logc3(input_rgb.x);
        output.y = linear_to_arri_logc3(input_rgb.y);
        output.z = linear_to_arri_logc3(input_rgb.z);
    } else if (output_tf == INPUT_TF_DAVINCI_INTERMEDIATE) {
        output.x = linear_to_davinci_intermediate(input_rgb.x);
        output.y = linear_to_davinci_intermediate(input_rgb.y);
        output.z = linear_to_davinci_intermediate(input_rgb.z);
    } else if (output_tf == INPUT_TF_PQ) {
        output.x = linear_to_st2084(input_rgb.x);
        output.y = linear_to_st2084(input_rgb.y);
        output.z = linear_to_st2084(input_rgb.z);
    } else if (output_tf == INPUT_TF_GAMMA_24) {
        output.x = powf(input_rgb.x * DISPLAY_MID_GRAY / 0.18f, 1.0f / 2.4f);
        output.y = powf(input_rgb.y * DISPLAY_MID_GRAY / 0.18f, 1.0f / 2.4f);
        output.z = powf(input_rgb.z * DISPLAY_MID_GRAY / 0.18f, 1.0f / 2.4f);
    }
    return output;
}

// clang-format off
__DEVICE__ float4 transition(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE__ p_FromTexR, __TEXTURE__ p_FromTexG, __TEXTURE__ p_FromTexB, __TEXTURE__ p_FromTexA, __TEXTURE__ p_ToTexR, __TEXTURE__ p_ToTexG, __TEXTURE__ p_ToTexB, __TEXTURE__ p_ToTexA) {
    // clang-format on

    float4 from_rgba = make_float4(_tex2D(p_FromTexR, p_X, p_Y), _tex2D(p_FromTexG, p_X, p_Y), _tex2D(p_FromTexB, p_X, p_Y), _tex2D(p_FromTexA, p_X, p_Y));
    float3 from_rgb = make_float3(from_rgba.x, from_rgba.y, from_rgba.z);

    float4 to_rgba = make_float4(_tex2D(p_ToTexR, p_X, p_Y), _tex2D(p_ToTexG, p_X, p_Y), _tex2D(p_ToTexB, p_X, p_Y), _tex2D(p_ToTexA, p_X, p_Y));
    float3 to_rgb = make_float3(to_rgba.x, to_rgba.y, to_rgba.z);


    float time = TRANSITION_PROGRESS;

    if (smooth) {
        time = smoothstep2(0.0f, 1.0f, time);
    }
    if (alpha_behavior == ALPHA_PREMULTIPLY || alpha_behavior == ALPHA_PREMULTIPLY_OUTPUT_1) {
        from_rgb *= from_rgba.w;
        to_rgb *= to_rgba.w;
    }

    // Convert to linear
    float3 from_rgb_linear = log_to_lin(from_rgb, input_tf);
    float3 to_rgb_linear = log_to_lin(to_rgb, input_tf);

    // Dissolve
    float3 result_linear = mixf3(from_rgb_linear, to_rgb_linear, time);
    float result_alpha = mixf(from_rgba.w, to_rgba.w, time);

    // Convert back to log.
    float3 result = lin_to_log(result_linear, input_tf);

    if (alpha_behavior == ALPHA_PREMULTIPLY) {
        result /= result_alpha;
        if (result_alpha == 0.0f) {
            result = make_float3(0.0f, 0.0f, 0.0f);
        }
    } else if (alpha_behavior == ALPHA_PREMULTIPLY_OUTPUT_1) {
        result_alpha = 1.0f;
    }

    float4 result_rgba = make_float4(result.x, result.y, result.z, result_alpha);
    return result_rgba;
}